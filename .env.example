# Copy to .env or export these variables; never commit real credentials.
DATABASE_URL=postgresql+psycopg://outbox:outbox_local_dev@127.0.0.1:55432/outbox
PUBLISHER=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=taxonomy.events
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=2.0
